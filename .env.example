# ============================================================
# Utsanova Blog Management System - Vercel Environment Variables
# ============================================================
# Copy these into your Vercel project environment settings and fill in the real values.
# Do not commit real secrets or credentials.

# App / runtime
PORT=3000
NODE_ENV=production
APP_URL=https://your-vercel-app-name.vercel.app
CORS_ALLOWED_ORIGINS=https://your-vercel-app-name.vercel.app,http://localhost:3000,http://localhost:5173

# MySQL
DATABASE_HOST=your_mysql_host
DATABASE_USER=your_mysql_user
DATABASE_PASSWORD=your_mysql_password
DATABASE_NAME=utsanova_blog
DATABASE_PORT=3306

# Firebase Admin SDK (backend verification)
FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Web SDK (frontend auth)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_API_BASE_URL=/api

# AI generation
GEMINI_API_KEY=your_gemini_api_key
